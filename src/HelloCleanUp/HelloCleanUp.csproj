<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with every Windows 10/11, so a fresh install runs the exe with nothing extra to download. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>7.3</LangVersion>
    <!-- AnyCPU without Prefer32Bit: 64-bit on x64, native on Windows ARM64 (.NET Framework 4.8.1). -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>HelloCleanUp</RootNamespace>
    <AssemblyName>HelloCleanUp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Keep in step with assemblyIdentity in app.manifest (CI checks it). -->
    <Version>1.2.0</Version>
    <Product>Hello, CleanUp.</Product>
    <Company>SevereClaw</Company>
    <Description>Чистка Windows и отключение телеметрии и рекламы</Description>
    <Copyright>SevereClaw</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
